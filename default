# Redirect all HTTP traffic to HTTPS
server {
    listen 80;
    server_name jrdesidelight.com www.jrdesidelight.com;
    return 301 https://$host$request_uri;
}

# HTTPS server block with SSL and reverse proxy settings
server {
    listen 443 ssl;
    server_name jrdesidelight.com www.jrdesidelight.com;

    # SSL certificate files
    ssl_certificate /etc/ssl/jrdesidelight.crt;
    ssl_certificate_key /etc/ssl/jrdesidelight.key;
    ssl_trusted_certificate /etc/ssl/ca-bundle.crt;

    # SSL protocols and ciphers
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256';
    ssl_prefer_server_ciphers on;

    # SSL session settings
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    add_header X-XSS-Protection "1; mode=block";

    # Hide Nginx version
    server_tokens off;

    # Reverse proxy configuration
    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
    location /joltify {
        proxy_pass http://localhost:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
